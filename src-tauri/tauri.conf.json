{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jotpad",
  "version": "0.1.7",
  "identifier": "com.jotpad.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:2430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Jotpad",
        "width": 980,
        "height": 660,
        "minWidth": 600,
        "minHeight": 400,
        "center": true,
        "decorations": true,
        "dragDropEnabled": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "fileAssociations": [
      {
        "ext": ["txt", "text", "log", "md", "markdown", "csv", "json", "xml", "yaml", "yml", "toml", "ini", "cfg", "conf"],
        "name": "Text Document",
        "description": "Text Document",
        "role": "Editor",
        "mimeType": "text/plain",
        "rank": "Default"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc4MDk3NkVEMEVBNUE2QzcKUldUSHBxVU83WFlKZUJwZ1loT2w0ZW9KYjUzQjduNzVDUGc4UFRDUkJ5ZklXOThqVG9YTjREN3cK",
      "endpoints": [
        "https://github.com/ZturnLibs/jotpad/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
